{
  "name": "motion-studio",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/core",
    "packages/studio",
    "mcp"
  ],
  "scripts": {
    "dev": "npm run dev -w @motion-studio/studio",
    "build": "npm run build -w @motion-studio/studio",
    "build:beat-path": "npm run build:beat-path -w @motion-studio/studio",
    "static-check": "node scripts/static-check.mjs",
    "vendor:arena": "node scripts/vendor-arena.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p packages/core && tsc -p packages/studio && tsc -p cli && tsc -p mcp",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm test",
    "smoke": "node scripts/smoke.mjs",
    "mcp-check": "node scripts/mcp-check.mjs",
    "hermes:setup": "node scripts/setup-hermes.mjs",
    "hermes": "node scripts/hermes-run.mjs",
    "review": "node scripts/runware-review.mjs",
    "examples": "node scripts/examples.mjs",
    "peek": "node scripts/peek.mjs",
    "mixamo-check": "node scripts/mixamo-check.mjs",
    "cli": "node cli/bin/motion-studio.mjs",
    "mcp": "node mcp/bin/motion-studio-mcp.mjs",
    "drums": "node scripts/drum-fixture.mjs out/drums-120.wav 120 8",
    "publish:clip": "node scripts/publish-clip.mjs",
    "finish": "node scripts/finish-clip.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/three": "^0.187.0",
    "ajv": "^8.20.0",
    "eslint": "^10.14.0",
    "playwright-core": "^1.65.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "bin": {
    "motion-studio": "cli/bin/motion-studio.mjs"
  },
  "description": "Motion Studio: a browser studio where a neutral figure moves to your track, an agent edits it by command or shot script, and the result exports as a guide clip for video models."
}
