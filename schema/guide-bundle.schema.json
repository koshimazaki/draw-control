{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guide-bundle.schema.json",
  "title": "Motion Studio guide bundle",
  "description": "Pinned local copy, version 0.3.0. The owner of this schema is model-arena/packages/core; re-sync this file whenever its schemaVersion changes. 0.2.0 (proposed here, 11 November 2026, not yet in model-arena) adds the optional camera track: manifest 'camera', $defs/camera the asset role 'camera', and the character kind 'rigged' (the bundled rigged mannequin). Fields follow the table 'The guide bundle' in docs/plan.md. 0.3.0 (proposed here, 11 November 2026, not yet in model-arena) adds optional drum-band onsets (beats.onsets.low/mid/high: kick, snare, hat) and amplitude peaks (beats.peaks), each a list of { seconds, strength }, re-based like the beats. A reader that refuses unknown keys in beats.json must be re-synced before it reads 0.3.0 bundles with onsets.",
  "type": "object",
  "required": [
    "schemaVersion",
    "video",
    "firstFrame",
    "beats",
    "recipe",
    "meta"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "video": {
      "type": "string",
      "pattern": "\\.mp4$",
      "description": "H.264 MP4, 24 fps, frame count 8k+1"
    },
    "audio": {
      "type": "string",
      "description": "The track, trimmed to the clip"
    },
    "firstFrame": {
      "type": "string",
      "pattern": "\\.png$"
    },
    "firstFrameStyled": {
      "type": "string"
    },
    "beats": {
      "type": "string",
      "pattern": "\\.json$"
    },
    "recipe": {
      "type": "string",
      "pattern": "\\.json$"
    },
    "meta": {
      "type": "string",
      "pattern": "\\.json$"
    },
    "camera": {
      "type": "string",
      "pattern": "\\.json$",
      "description": "Optional (0.2.0): per-frame camera track of the audio-reactive rig"
    }
  },
  "$defs": {
    "beats": {
      "type": "object",
      "required": [
        "bpm",
        "offsetSeconds",
        "beatsPerBar",
        "source",
        "beats",
        "downbeats"
      ],
      "additionalProperties": false,
      "properties": {
        "bpm": {
          "type": "number",
          "minimum": 40,
          "maximum": 240
        },
        "offsetSeconds": {
          "type": "number",
          "minimum": 0
        },
        "beatsPerBar": {
          "type": "integer",
          "minimum": 1
        },
        "source": {
          "enum": [
            "manual",
            "analysis"
          ]
        },
        "beats": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "downbeats": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "onsets": {
          "type": "object",
          "description": "Optional (0.3.0): onsets per drum band; low = kick (30-150 Hz), mid = snare (1.5-6 kHz), high = hat (above 6 kHz)",
          "required": [
            "low",
            "mid",
            "high"
          ],
          "additionalProperties": false,
          "properties": {
            "low": {
              "$ref": "#/$defs/onsetList"
            },
            "mid": {
              "$ref": "#/$defs/onsetList"
            },
            "high": {
              "$ref": "#/$defs/onsetList"
            }
          }
        },
        "peaks": {
          "$ref": "#/$defs/onsetList",
          "description": "Optional (0.3.0): overall amplitude peaks"
        }
      }
    },
    "meta": {
      "type": "object",
      "required": [
        "schemaVersion",
        "width",
        "height",
        "fps",
        "frames",
        "durationSeconds",
        "view",
        "character",
        "generator",
        "audioInVideo",
        "assets"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "type": "string"
        },
        "width": {
          "type": "integer",
          "minimum": 16
        },
        "height": {
          "type": "integer",
          "minimum": 16
        },
        "fps": {
          "const": 24
        },
        "frames": {
          "type": "integer",
          "minimum": 1,
          "description": "8k+1",
          "multipleOf": 1
        },
        "durationSeconds": {
          "type": "number",
          "minimum": 0
        },
        "view": {
          "type": "string"
        },
        "character": {
          "type": "object",
          "required": [
            "kind",
            "name"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "mannequin",
                "block",
                "file",
                "rigged"
              ]
            },
            "name": {
              "type": "string"
            }
          }
        },
        "generator": {
          "type": "object",
          "required": [
            "name",
            "version",
            "motion"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "motion": {
              "type": "string"
            }
          }
        },
        "audioInVideo": {
          "type": "boolean"
        },
        "assets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "role",
              "name",
              "licence"
            ],
            "additionalProperties": false,
            "properties": {
              "role": {
                "enum": [
                  "video",
                  "audio",
                  "firstFrame",
                  "character",
                  "motion",
                  "recipe",
                  "beats",
                  "camera"
                ]
              },
              "name": {
                "type": "string"
              },
              "licence": {
                "type": "string",
                "minLength": 1
              },
              "file": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "camera": {
      "type": "object",
      "required": [
        "schemaVersion",
        "fps",
        "frames",
        "startFrame",
        "aspect",
        "fovAxis",
        "units",
        "axes",
        "intensity",
        "modes",
        "accents",
        "track",
        "ltx"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "type": "string"
        },
        "fps": {
          "const": 24
        },
        "frames": {
          "type": "integer",
          "minimum": 1
        },
        "startFrame": {
          "type": "integer",
          "minimum": 0
        },
        "aspect": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "fovAxis": {
          "const": "vertical"
        },
        "units": {
          "const": "metres"
        },
        "axes": {
          "type": "string"
        },
        "intensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "modes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "fromBeat",
              "toBeat",
              "modes"
            ],
            "additionalProperties": false,
            "properties": {
              "fromBeat": {
                "type": "number"
              },
              "toBeat": {
                "type": "number"
              },
              "modes": {
                "type": "array",
                "items": {
                  "enum": [
                    "static",
                    "orbit",
                    "pushIn",
                    "pullOut",
                    "rise",
                    "lead",
                    "chase",
                    "path"
                  ]
                }
              }
            }
          }
        },
        "accents": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "seconds",
              "downbeat"
            ],
            "additionalProperties": false,
            "properties": {
              "seconds": {
                "type": "number",
                "minimum": 0
              },
              "downbeat": {
                "type": "boolean"
              }
            }
          }
        },
        "track": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "frame",
              "position",
              "target",
              "fov",
              "energy"
            ],
            "additionalProperties": false,
            "properties": {
              "frame": {
                "type": "integer",
                "minimum": 0
              },
              "position": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "target": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "fov": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 180
              },
              "energy": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "ltx": {
          "type": "object",
          "required": [
            "settings",
            "approximate",
            "scores",
            "note"
          ],
          "additionalProperties": false,
          "properties": {
            "settings": {
              "type": "object",
              "required": [
                "cameraMovement"
              ],
              "additionalProperties": false,
              "properties": {
                "cameraMovement": {
                  "enum": [
                    "dolly_in",
                    "dolly_out",
                    "dolly_left",
                    "dolly_right",
                    "jib_up",
                    "jib_down",
                    "static",
                    "focus_shift"
                  ]
                }
              }
            },
            "approximate": {
              "const": true
            },
            "scores": {
              "type": "object",
              "required": [
                "dolly",
                "lateral",
                "jib"
              ],
              "additionalProperties": false,
              "properties": {
                "dolly": {
                  "type": "number"
                },
                "lateral": {
                  "type": "number"
                },
                "jib": {
                  "type": "number"
                }
              }
            },
            "note": {
              "type": "string"
            }
          }
        }
      }
    },
    "onsetList": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "seconds",
          "strength"
        ],
        "additionalProperties": false,
        "properties": {
          "seconds": {
            "type": "number",
            "minimum": 0
          },
          "strength": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  }
}
